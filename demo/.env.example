# Upstash Redis (challenge + session store). Create at https://console.upstash.com
UPSTASH_REDIS_REST_URL="https://example-12345.upstash.io"
UPSTASH_REDIS_REST_TOKEN="replace-me"

# Exact origin the browser loads. Signed into every challenge and enforced on every
# state-changing request, so it must match what the browser actually sends.
APP_ORIGIN="http://localhost:3000"

# mainnet | testnet | devnet | localnet
SUI_NETWORK="mainnet"

# Optional. Overrides the public fullnode gRPC endpoint derived from SUI_NETWORK.
# SUI_RPC_URL="https://fullnode.mainnet.sui.io:443"

# NAMESPACE_API_KEY is added in Phase 3.
